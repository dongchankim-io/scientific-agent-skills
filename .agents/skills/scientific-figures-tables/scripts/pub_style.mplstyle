# Publication-Grade Matplotlib Style Sheet (Okabe-Ito Colorblind-Safe Palette)
figure.figsize : 3.5, 2.5
figure.dpi : 300
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.03

font.size : 9
axes.titlesize : 9
axes.labelsize : 9
xtick.labelsize : 8
ytick.labelsize : 8
legend.fontsize : 8
legend.frameon : False

axes.spines.top : False
axes.spines.right : False
axes.linewidth : 0.8
axes.grid : True
grid.alpha : 0.25
grid.linestyle : --
grid.linewidth : 0.5

lines.linewidth : 1.5
lines.markersize : 4.5

# Okabe-Ito colorblind-safe cycle
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', '56B4E9', 'E69F00', 'F0E442', '000000'])

pdf.fonttype : 42
ps.fonttype : 42
